plans/
bin/
# Sentinel the ci job caches to record that this source state already passed
.ci-test-passed
# TG_RSA_KEY_PATH defaults to ./server_key.pem, so a local run writes a live private key here
*.pem
*.key
# TG_BLOB_DIR defaults to ./blobs, so a local run writes uploaded file bodies here
blobs/
.env
.env.*
# Must stay below .env.*, which would otherwise swallow it; the template carries
# no secret values.
!.env.example
