package admin

import (
	"github.com/adambenhassen/telegram-server/components/alert"
	"github.com/adambenhassen/telegram-server/components/badge"
	"github.com/adambenhassen/telegram-server/components/button"
	"github.com/adambenhassen/telegram-server/components/card"
	"github.com/adambenhassen/telegram-server/components/progress"
	"github.com/adambenhassen/telegram-server/components/table"
)

// dashboardPage renders the authenticated admin operations dashboard.
templ dashboardPage(d DashboardData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Operations — telegram-server</title>
			<link rel="stylesheet" href="/admin/assets/dashboard.css"/>
			<script type="module" src="/admin/assets/datastar.min.js"></script>
			<script defer src="/admin/assets/shadcn-templ.js"></script>
			<script>
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					document.documentElement.classList.add('dark');
				}
			</script>
		</head>
		<body class="style-nova min-h-screen bg-background text-foreground">
			<a href="#main" class="skip">Skip to content</a>
			<div class="dashboard-shell mx-auto max-w-[1440px]">
				<header class="dashboard-header">
					<div class="dashboard-title-block">
						<h1 class="text-xl font-semibold leading-tight">Operations</h1>
						<span class="text-xs text-muted-foreground">telegram-server</span>
					</div>
					<div class="dashboard-controls">
						<span
							id="chip"
							class="chip chip-good inline-flex cursor-default items-center gap-1.5 rounded-full border border-transparent px-2.5 py-1 text-xs font-medium"
							title={ "Server snapshot: " + d.ServerTimestamp }
						>
							<span class="chip-dot size-1.5 rounded-full bg-current flex-shrink-0"></span>
							<span id="chip-text">Live &middot; connecting&hellip;</span>
						</span>
						<span class="dashboard-snapshot text-xs text-muted-foreground sm:block">Snapshot { d.ServerTimestamp }</span>
						@button.Button(button.Props{ID: "refresh-btn", Class: "dashboard-control", Variant: button.VariantGhost, Type: button.TypeButton, Attributes: templ.Attributes{"aria-label": "Reload page"}}) {
							&#8635; Reload
						}
						<form method="post" action="/admin/logout" class="logout-form inline">
							<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
							@button.Button(button.Props{Class: "dashboard-control", Variant: button.VariantGhost, Type: button.TypeSubmit}) {
								Log out
							}
						</form>
					</div>
					<p id="status-live" class="sr-only" role="status" aria-live="polite" aria-atomic="true">Connecting to live updates…</p>
				</header>
				<main id="main" aria-labelledby="h-replica">
					@alert.Alert(alert.Props{
						ID: "banner-disconnected",
						Class: "hidden mb-4",
						Variant: alert.VariantDestructive,
						Attributes: templ.Attributes{"aria-atomic": "true"},
					}) {
						@alert.Description() { <span id="banner-dc-text">Live updates disconnected. Showing the last successful sample.</span> }
						@alert.Action() {
							@button.Button(button.Props{Variant: button.VariantGhost, Href: "/admin/login"}) { Log in again }
						}
					}
					@alert.Alert(alert.Props{
						ID: "banner-auth",
						Class: "hidden mb-4",
						Variant: alert.VariantDestructive,
						Attributes: templ.Attributes{"aria-atomic": "true"},
					}) {
						@alert.Description() { Session ended. Log in again. }
						@alert.Action() {
							@button.Button(button.Props{Variant: button.VariantGhost, Href: "/admin/login"}) { Log in again }
						}
					}
					@alert.Alert(alert.Props{
						ID: "banner-stale",
						Class: "hidden mb-4",
						Variant: alert.VariantDefault,
						Attributes: templ.Attributes{"aria-atomic": "true", "data-server-stale": d.SnapshotStatus},
					}) {
						@alert.Description() { Metrics have not refreshed. Showing the last successful sample. }
					}
					@alert.Alert(alert.Props{
						ID: "banner-source",
						Class: "hidden banner-source",
						Variant: alert.VariantDefault,
						Attributes: templ.Attributes{"aria-atomic": "true"},
					}) {
						@alert.Description() { <span id="banner-source-text"></span> }
					}
					<div id="sse-root" data-sse-event={ sseDefaultEvent } data-on-load="@get('/admin/events', {openWhenHidden: true})">
						<div
							id="metrics-stream"
							data-sample-timestamp={ d.SampleTimestamp }
							data-sample-age-seconds={ d.SampleAgeSeconds }
							data-sample-state={ d.SampleState }
							data-process-started-at={ d.ProcessStartedAt }
							data-process-generation={ d.ProcessGeneration }
							data-replica-id={ d.ReplicaID }
						>
							@metricsFragment(d)
						</div>
					</div>
				</main>
			</div>
			@chipScript()
		</body>
	</html>
}

// dashboardUnavailablePage gives an authenticated operator a safe recovery
// path without exposing collection errors or fabricated zero values.
templ dashboardUnavailablePage(d DashboardData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Operations — telegram-server</title>
			<link rel="stylesheet" href="/admin/assets/dashboard.css"/>
		</head>
		<body class="style-nova min-h-screen bg-background text-foreground">
			<div class="dashboard-shell mx-auto max-w-[1440px]">
				<header class="dashboard-header">
					<div class="dashboard-title-block">
						<h1 class="text-xl font-semibold leading-tight">Operations</h1>
						<span class="text-xs text-muted-foreground">telegram-server</span>
					</div>
					<div class="dashboard-controls">
						@button.Button(button.Props{ID: "refresh-btn", Class: "dashboard-control", Variant: button.VariantGhost, Type: button.TypeButton, Attributes: templ.Attributes{"aria-label": "Reload page"}}) { &#8635; Reload }
						<form method="post" action="/admin/logout" class="logout-form inline">
							<input type="hidden" name="csrf_token" value={ d.CSRFToken }/>
							@button.Button(button.Props{Class: "dashboard-control", Variant: button.VariantGhost, Type: button.TypeSubmit}) { Log out }
						</form>
					</div>
				</header>
				<main id="main" aria-labelledby="metrics-unavailable-title">
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title(alert.TitleProps{ID: "metrics-unavailable-title"}) { Metrics are unavailable. Try reloading. }
						@alert.Description() { No complete metrics sample is available right now. }
					}
				</main>
			</div>
			<script>
				document.getElementById('refresh-btn').addEventListener('click', function() { location.reload(); });
			</script>
		</body>
	</html>
}

// metricsFragment is the single SSE morph target. It contains only aggregate
// allowlisted data and no session-bound values.
templ metricsFragment(d DashboardData) {
	if d.ShowEmptyAlert {
		@alert.Alert(alert.Props{ID: "banner-empty", Variant: alert.VariantDefault, Attributes: templ.Attributes{"aria-atomic": "true"}}) {
			@alert.Description() { No account or message activity recorded yet. Metric availability is shown individually. }
		}
	} else {
		@alert.Alert(alert.Props{ID: "banner-empty", Class: "hidden", Variant: alert.VariantDefault, Attributes: templ.Attributes{"aria-atomic": "true"}}) {
			@alert.Description() { No account or message activity recorded yet. Metric availability is shown individually. }
		}
	}

	<section class="dashboard-section" aria-labelledby="h-replica">
		<div class="dashboard-section-heading">
			<div>
				<h2 id="h-replica" class="dashboard-section-title">{ d.ReplicaScope }</h2>
				<p class="dashboard-section-subtitle">Point-in-time gauges · all readings are for this replica.</p>
			</div>
			<p class="dashboard-reset-copy">{ d.ReplicaResetCopy }</p>
		</div>
		<div class="dashboard-card-grid dashboard-gauge-grid">
			@card.Card() {
				@card.Content() {
					@simpleReading("v-connections", "connections", "Live connections", d.Connections, "All open MTProto connections on this replica.", "")
				}
			}
			@card.Card() {
				@card.Content() {
					@simpleReading("v-sessions", "sessions", "Authenticated accounts connected", d.Sessions, "Distinct accounts with a live connection on this replica; an account can appear on another replica too.", "")
				}
			}
		</div>
	</section>

	<section class="dashboard-section" aria-labelledby="h-delivery">
		<div class="dashboard-section-heading">
			<div>
				<h2 id="h-delivery" class="dashboard-section-title">Delivery</h2>
				<p class="dashboard-section-subtitle">This replica · sampled aggregate</p>
			</div>
		</div>
		<div class="dashboard-family-grid">
			@card.Card(card.Props{ID: "delivery-lag-card"}) {
				@card.Header() {
					<h3 class="dashboard-card-title">Delivery lag · gauge</h3>
					<p class="dashboard-card-description">Worst live-connection lag, measured in PTS.</p>
				}
				@card.Content() {
					@metricReading(d.Delivery.Worst, "metric-primary")
					<dl class="dashboard-meta-grid" aria-label="Delivery lag sample details">
						<dt>Sample</dt><dd>{ d.Delivery.Sample }</dd>
						<dt>Coverage</dt><dd>{ d.Delivery.Coverage }</dd>
						<dt>Sampled connections</dt><dd>{ d.Delivery.SampledConnections } of { d.Delivery.EligibleConnections }</dd>
					</dl>
					@metricReading(d.Delivery.AccountHeadSpread, "metric-secondary")
				}
			}
			@card.Card(card.Props{ID: "push-writes-card"}) {
				@card.Header() {
					<h3 class="dashboard-card-title">Push writes · distribution</h3>
					<p class="dashboard-card-description">Persisted account updates (<code>tg_updates</code>) only · successful connection writes.</p>
				}
				@card.Content() {
					<div class="dashboard-two-up">
						@metricReading(d.Push.P50, "metric-primary")
						@metricReading(d.Push.P95, "metric-primary")
					</div>
					<p class="dashboard-sample-count"><span>Successful samples</span> <strong>{ d.Push.SampleCount }</strong></p>
					<p class="dashboard-window-label">Observation window · last { d.Push.Window } · this replica</p>
					if d.Push.WindowStatus != "" {
						<p class="dashboard-window-status">{ d.Push.WindowStatus }</p>
					}
					<p class="dashboard-helper">Valid notification acceptance to completed connection write. Successful writes only; each successful connection contributes one sample.</p>
					@countTable("push-outcomes-table", "Push write outcomes", "Outcome", d.Push.Outcomes)
					<p class="dashboard-table-note">One outcome per attempted connection. Failed attempts do not enter successful-write percentiles.</p>
				}
			}
		</div>
	</section>

	<section class="dashboard-section" aria-labelledby="h-work">
		<div class="dashboard-section-heading">
			<div>
				<h2 id="h-work" class="dashboard-section-title">Notification work and denials</h2>
				<p class="dashboard-section-subtitle">This replica · rolling windows</p>
			</div>
		</div>
		<div class="dashboard-family-grid">
			@card.Card(card.Props{ID: "notifications-card"}) {
				@card.Header() {
					<h3 class="dashboard-card-title">Notifications · rolling window</h3>
					<p class="dashboard-card-description">Valid delivery work accepted by compiled channel.</p>
				}
				@card.Content() {
					<div class="dashboard-two-up">
						@metricReading(d.Notifications.Count, "metric-primary")
						@metricReading(d.Notifications.Rate, "metric-primary")
					</div>
					<p class="dashboard-window-label">Rolling window · last { d.Notifications.Window } · this replica</p>
					if d.Notifications.WindowStatus != "" {
						<p class="dashboard-window-status">{ d.Notifications.WindowStatus }</p>
					}
					if d.Notifications.WindowHelper != "" {
						<p class="dashboard-helper">{ d.Notifications.WindowHelper }</p>
					}
					@countTable("notifications-table", "Valid notifications by channel", "Channel", d.Notifications.Rows)
					<div class="dashboard-secondary-count"><span>{ d.Notifications.Invalid.Label }</span><strong id={ d.Notifications.Invalid.ID }>{ d.Notifications.Invalid.Value }</strong></div>
					<p class="dashboard-helper">Excluded from valid notifications.</p>
				}
			}
			@card.Card(card.Props{ID: "denials-card"}) {
				@card.Header() {
					<h3 class="dashboard-card-title">Rate-limit denials · rolling window</h3>
					<p class="dashboard-card-description">Fixed client-visible surfaces only.</p>
				}
				@card.Content() {
					<div class="dashboard-two-up">
						@metricReading(d.Denials.Count, "metric-primary")
						@metricReading(d.Denials.Rate, "metric-primary")
					</div>
					<p class="dashboard-window-label">Rolling window · last { d.Denials.Window } · this replica</p>
					if d.Denials.WindowStatus != "" {
						<p class="dashboard-window-status">{ d.Denials.WindowStatus }</p>
					}
					if d.Denials.WindowHelper != "" {
						<p class="dashboard-helper">{ d.Denials.WindowHelper }</p>
					}
					@countTable("denials-table", "Denials by surface", "Surface", d.Denials.Rows)
					<div class="dashboard-secondary-count"><span>{ d.Denials.Dropped.Label }</span><strong id={ d.Denials.Dropped.ID }>{ d.Denials.Dropped.Value }</strong></div>
					<p class="dashboard-helper">Dropped observations are excluded from denials and the surface table.</p>
				}
			}
		</div>
	</section>

	<section class="dashboard-section" aria-labelledby="h-rpc">
		@card.Card(card.Props{ID: "rpc-diagnostics-card"}) {
			@card.Header() {
				<h2 id="h-rpc" class="dashboard-card-title">RPC diagnostics</h2>
				<p class="dashboard-card-description">Capability note</p>
			}
			@card.Content() {
				<p class="dashboard-capability-note">{ d.RPCNote }</p>
			}
		}
	</section>

	<section class="dashboard-section" aria-labelledby="h-database">
		<div class="dashboard-section-heading">
			<div>
				<h2 id="h-database" class="dashboard-section-title">Shared database</h2>
				<p class="dashboard-section-subtitle">Point-in-time counts · last-hour and 24-hour activity windows</p>
			</div>
		</div>
		<div class="dashboard-card-grid dashboard-database-grid">
			@card.Card() {
				@card.Header() { <h3 class="dashboard-card-title">Accounts</h3> }
				@card.Content() {
					@simpleReading("v-total_users", "total_users", "Total accounts", d.SharedDatabase.TotalUsers, "Registered accounts in the shared database.", "")
					<hr class="dashboard-rule"/>
					@simpleReading("v-active_users_1h", "active_users_1h", "Active accounts · last hour", d.SharedDatabase.ActiveUsers1H, "Accounts with account activity in the last hour, using last_seen_at semantics.", "")
					<hr class="dashboard-rule"/>
					<dl class="dashboard-reading">
						<dt>Active accounts · last 24 hours</dt>
						<dd id="v-active_users_24h" data-metric="active_users_24h" class="metric-value tabular-nums">{ d.SharedDatabase.ActiveUsers24H }</dd>
						<dd>
							if d.SharedDatabase.ActiveUsersMeta != "" {
								<div id="meter-wrap" class="mt-2">
									@progress.Progress(progress.Props{Value: int(d.SharedDatabase.ActiveUsersPct), Attributes: templ.Attributes{"aria-label": "Active accounts ratio"}}) {}
									<p id="meter-text" class="mt-1 text-xs text-muted-foreground">{ d.SharedDatabase.ActiveUsersMeta }</p>
								</div>
							} else {
								<div id="meter-wrap" class="hidden mt-2">
									@progress.Progress(progress.Props{Value: 0, Attributes: templ.Attributes{"aria-label": "Active accounts ratio"}}) {}
									<p id="meter-text" class="mt-1 text-xs text-muted-foreground"></p>
								</div>
							}
							<p class="dashboard-helper">Accounts with account activity in the last 24 hours.</p>
						</dd>
					</dl>
				}
			}
			@card.Card() {
				@card.Header() { <h3 class="dashboard-card-title">Content</h3> }
				@card.Content() {
					@simpleReading("v-total_channels", "total_channels", "Channels", d.SharedDatabase.TotalChannels, "Channels in the shared database.", "")
					<hr class="dashboard-rule"/>
					@simpleReading("v-total_chats", "total_chats", "Group chats", d.SharedDatabase.TotalChats, "Group chats in the shared database.", "")
					<hr class="dashboard-rule"/>
					@simpleReading("v-messages_1h", "messages_1h", "Stored messages · last hour", d.SharedDatabase.Messages1H, "Non-deleted message rows by message date, including per-account copies and channel messages.", "")
					<hr class="dashboard-rule"/>
					@simpleReading("v-messages_24h", "messages_24h", "Stored messages · last 24 hours", d.SharedDatabase.Messages24H, "Non-deleted message rows by message date, including per-account copies and channel messages.", "")
				}
			}
			@card.Card() {
				@card.Header() { <h3 class="dashboard-card-title">Active limits</h3> }
				@card.Content() {
					@simpleReading("v-rate_limit_active", "rate_limit_active", "Active rate-limit rows", d.SharedDatabase.RateLimitActive, "Unexpired rate-limit rows. This is not a count of denied requests.", "")
				}
			}
		</div>
		@card.Card(card.Props{ID: "storage-card", Class: "mt-4"}) {
				@card.Header() {
					<h3 class="dashboard-card-title">Storage</h3>
					<p class="dashboard-card-description">Approximate row counts for the allowlisted tables.</p>
				}
				@card.Content(card.ContentProps{Class: "p-0"}) {
					<div class="dashboard-table-wrap">
						@table.Table(table.Props{Class: "dashboard-table"}) {
							@table.Caption(table.CaptionProps{Class: "sr-only"}) { Storage row counts and estimate sources }
							@table.Header() {
								@table.Row() {
									@table.Head(table.HeadProps{Attributes: templ.Attributes{"scope": "col"}}) { Table }
									@table.Head(table.HeadProps{Attributes: templ.Attributes{"scope": "col"}}) { Rows }
									@table.Head(table.HeadProps{Attributes: templ.Attributes{"scope": "col"}}) { Source }
								}
							}
							@table.Body(table.BodyProps{ID: "storage-tbody"}) {
								for _, row := range d.StorageRows {
									@storageRow(row)
								}
							}
						}
					</div>
				}
			}
		<p class="dashboard-fleet-copy">{ d.FleetAggregation }</p>
	</section>

	if len(d.UninstrumentedNames) > 0 {
		@card.Card(card.Props{ID: "uninstr-card", Class: "uninstr-card mt-4"}) {
			@card.Content() {
				<p class="mb-1 text-xs font-medium text-muted-foreground">Not yet instrumented</p>
				<ul class="uninstr-list list-none text-xs text-muted-foreground">
					for _, u := range d.UninstrumentedNames {
						<li>{ u.Label }</li>
					}
				</ul>
				<p class="mt-2 text-xs text-muted-foreground leading-snug">These are not measured yet. They are not readings of zero.</p>
			}
		}
	} else {
		@card.Card(card.Props{ID: "uninstr-card", Class: "uninstr-card hidden mt-4"}) {
			@card.Content() {
				<p class="mb-1 text-xs font-medium text-muted-foreground">Not yet instrumented</p>
				<ul class="uninstr-list list-none text-xs text-muted-foreground"></ul>
				<p class="mt-2 text-xs text-muted-foreground leading-snug">These are not measured yet. They are not readings of zero.</p>
			}
		}
	}
}

templ simpleReading(id, metric, label, value, helper, state string) {
	<dl class="dashboard-reading">
		<dt>{ label }</dt>
		<dd id={ id } data-metric={ metric } class="metric-value tabular-nums">
			{ value }
			if state != "" {
				<p class="metric-state">{ state }</p>
			}
			if helper != "" {
				<p class="dashboard-helper">{ helper }</p>
			}
		</dd>
	</dl>
}

templ metricReading(reading DashMetric, extraClass string) {
	<dl class={ "dashboard-reading " + extraClass } data-reading-state={ reading.State }>
		<dt>{ reading.Label }</dt>
		<dd id={ reading.ID } data-metric={ reading.Metric } class="metric-value tabular-nums">
			{ reading.Value }
			if reading.State != "" && reading.State != reading.Value {
				<p class="metric-state">{ reading.State }</p>
			}
			if reading.Helper != "" {
				<p class="dashboard-helper">{ reading.Helper }</p>
			}
		</dd>
	</dl>
}

templ countTable(id, caption, firstHeading string, rows []DashCountRow) {
	<div class="dashboard-table-wrap">
		@table.Table(table.Props{ID: id, Class: "dashboard-table"}) {
			@table.Caption(table.CaptionProps{Class: "sr-only"}) { { caption } }
			@table.Header() {
				@table.Row() {
					@table.Head(table.HeadProps{Attributes: templ.Attributes{"scope": "col"}}) { { firstHeading } }
					@table.Head(table.HeadProps{Class: "text-right", Attributes: templ.Attributes{"scope": "col"}}) { Count }
				}
			}
			@table.Body() {
				for _, row := range rows {
					@table.Row(table.RowProps{ID: row.ID}) {
						@table.Cell(table.CellProps{Attributes: templ.Attributes{"data-label": firstHeading}}) { { row.Label } }
						@table.Cell(table.CellProps{Class: "text-right tabular-nums", Attributes: templ.Attributes{"data-label": "Count"}}) { { row.Value } }
						}
				}
				}
		}
	</div>
}

templ storageRow(row DashStorageRow) {
	@table.Row() {
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"data-label": "Table"}}) { <code class="font-mono text-xs">{ row.Table }</code> }
		if row.Source == "Unknown" {
			@table.Cell(table.CellProps{Class: "tabular-nums", Attributes: templ.Attributes{"data-label": "Rows"}}) {
				<span>Unavailable</span>
				<span class="dashboard-cell-helper">Estimate not available yet.</span>
			}
		} else {
			@table.Cell(table.CellProps{Class: "tabular-nums", Attributes: templ.Attributes{"data-label": "Rows"}}) { { row.Display } }
		}
		@table.Cell(table.CellProps{Attributes: templ.Attributes{"data-label": "Source"}}) {
			switch row.Source {
				case "Exact": @badge.Badge(badge.Props{Variant: badge.VariantDefault}) { Exact }
				case "Estimated": @badge.Badge(badge.Props{Variant: badge.VariantSecondary}) { Estimated }
				default: @badge.Badge(badge.Props{Variant: badge.VariantGhost}) { Unknown }
			}
		}
	}
}

// chipScript is the only client-side freshness state machine. It uses the
// server-provided sample age plus performance.now(), so heartbeats and wall
// clock changes cannot make a retained sample fresh.
templ chipScript() {
	<script>
		(function() {
			'use strict';
			var chipEl = document.getElementById('chip');
			var chipText = document.getElementById('chip-text');
			var bannerDc = document.getElementById('banner-disconnected');
			var bannerAuth = document.getElementById('banner-auth');
			var bannerStale = document.getElementById('banner-stale');
			var bannerSource = document.getElementById('banner-source');
			var bannerSourceText = document.getElementById('banner-source-text');
			var statusLive = document.getElementById('status-live');
			var refreshBtn = document.getElementById('refresh-btn');
			var sseRoot = document.getElementById('sse-root');
			var metricsStream = document.getElementById('metrics-stream');
			var connected = false;
			var authExpired = false;
			var hasLiveSignal = false;
			var hasLiveSample = false;
			var initialServerStale = !!(bannerStale && bannerStale.getAttribute('data-server-stale'));
			var sampleTimestamp = metricsStream ? metricsStream.getAttribute('data-sample-timestamp') || '' : '';
			var sampleAgeSeconds = metricsStream ? parseAge(metricsStream.getAttribute('data-sample-age-seconds')) : 0;
			var sampleState = metricsStream ? metricsStream.getAttribute('data-sample-state') || '' : '';
			var sampleObservedAt = performance.now();
			var sourceGeneration = metricsStream ? metricsStream.getAttribute('data-process-generation') || '' : '';
			var sourceReplica = metricsStream ? metricsStream.getAttribute('data-replica-id') || '' : '';
			var sourceNotice = '';
			var sourceNoticeProcessAgeSeconds = NaN;
			var sourceNoticeObservedAt = 0;
			var sourceNoticeWindowSeconds = 3600;
			var dataEvent = sseRoot ? sseRoot.getAttribute('data-sse-event') : '';
			var baseChipClass = 'chip inline-flex cursor-default items-center gap-1.5 rounded-full border border-transparent px-2.5 py-1 text-xs font-medium';

			function parseAge(value) {
				var age = Number(value);
				return isFinite(age) && age >= 0 ? age : 0;
			}

			function parseTimestamp(value) {
				var timestamp = Date.parse(value);
				return isFinite(timestamp) ? timestamp : NaN;
			}

			function ago(seconds) {
				var s = Math.round(Math.max(0, seconds));
				if (s < 60) return s + 's ago';
				var m = Math.round(s / 60);
				if (m < 60) return m + 'm ago';
				return Math.round(m / 60) + 'h ago';
			}

			function currentSampleAge() {
				return Math.max(0, sampleAgeSeconds + (performance.now() - sampleObservedAt) / 1000);
			}

			function processAgeSeconds(timestamp, age, startedAt) {
				var timestampMs = parseTimestamp(timestamp);
				var startedAtMs = parseTimestamp(startedAt);
				if (!isFinite(timestampMs) || !isFinite(startedAtMs)) return NaN;
				return Math.max(0, (timestampMs - startedAtMs) / 1000) + parseAge(age);
			}

			function clearSourceNotice() {
				sourceNotice = '';
				sourceNoticeProcessAgeSeconds = NaN;
				sourceNoticeObservedAt = 0;
				if (bannerSource) bannerSource.classList.add('hidden');
				if (bannerSourceText) bannerSourceText.textContent = '';
			}

			function expireSourceNotice() {
				if (!sourceNotice || !isFinite(sourceNoticeProcessAgeSeconds)) return;
				var processAge = sourceNoticeProcessAgeSeconds +
					Math.max(0, (performance.now() - sourceNoticeObservedAt) / 1000);
				if (processAge >= sourceNoticeWindowSeconds) clearSourceNotice();
			}

			function setStatus(text) {
				if (statusLive && statusLive.textContent !== text) statusLive.textContent = text;
			}

			function updateSampleMetadata() {
				var stream = document.getElementById('metrics-stream');
				if (!stream) return;
				var nextTimestamp = stream.getAttribute('data-sample-timestamp') || '';
				var nextAge = parseAge(stream.getAttribute('data-sample-age-seconds'));
				var observedAt = performance.now();
				var nextTimestampMs = parseTimestamp(nextTimestamp);
				var sampleTimestampMs = parseTimestamp(sampleTimestamp);
				var newerSample = isFinite(nextTimestampMs) && (!isFinite(sampleTimestampMs) || nextTimestampMs > sampleTimestampMs);
				var sameSample = isFinite(nextTimestampMs) && isFinite(sampleTimestampMs) && nextTimestampMs === sampleTimestampMs;
				var nextStartedAt = stream.getAttribute('data-process-started-at') || '';
				var nextGeneration = stream.getAttribute('data-process-generation') || '';
				var nextReplica = stream.getAttribute('data-replica-id') || '';
				var generationChanged = nextGeneration !== sourceGeneration && (sourceGeneration !== '' || nextGeneration !== '');
				var replicaChanged = sourceReplica !== nextReplica;
				if (generationChanged || replicaChanged) {
					if (generationChanged && sourceReplica !== '' && nextReplica !== '' && sourceReplica === nextReplica) {
						sourceNotice = 'Restart detected';
						if (bannerSourceText) bannerSourceText.textContent = 'Replica restarted. Rolling metrics reset; collecting a new window.';
					} else {
						sourceNotice = 'Metrics source changed';
						if (bannerSourceText) bannerSourceText.textContent = 'Metrics source changed. Verify the replica before comparing samples.';
					}
					sourceNoticeProcessAgeSeconds = processAgeSeconds(nextTimestamp, nextAge, nextStartedAt);
					if (!isFinite(sourceNoticeProcessAgeSeconds)) sourceNoticeProcessAgeSeconds = 0;
					sourceNoticeObservedAt = observedAt;
					if (bannerSource) bannerSource.classList.remove('hidden');
				}
				sourceGeneration = nextGeneration;
				sourceReplica = nextReplica;
				if (!newerSample && !sameSample) {
					expireSourceNotice();
					return;
				}

				var nextState = stream.getAttribute('data-sample-state') || '';
				if (newerSample) {
					sampleTimestamp = nextTimestamp;
					sampleAgeSeconds = nextAge;
					sampleObservedAt = observedAt;
					if (nextState === 'available' || nextState === 'stale') sampleState = nextState;
				} else {
					var localAge = Math.max(0, sampleAgeSeconds + (observedAt - sampleObservedAt) / 1000);
					if (nextAge > localAge) {
						sampleAgeSeconds = nextAge;
						sampleObservedAt = observedAt;
					}
					if (nextState === 'stale' || (nextState === 'available' && sampleState !== 'stale')) sampleState = nextState;
				}

				expireSourceNotice();
			}

			function setChip(cls, text) {
				if (!chipEl || !chipText) return;
				chipEl.className = baseChipClass + ' ' + cls;
				chipText.textContent = text;
			}

			function updateBanners(age) {
				var stale = sampleState === 'stale' || age >= 40;
				if (bannerStale) {
					if (stale && !authExpired && (connected || (initialServerStale && !hasLiveSignal))) bannerStale.classList.remove('hidden');
					else bannerStale.classList.add('hidden');
				}
				return stale;
			}

			function updateChip() {
				expireSourceNotice();
				var age = currentSampleAge();
				var notice = sourceNotice ? ' · ' + sourceNotice : '';
				if (authExpired) {
					setChip('chip-critical', '● Session ended. Log in again.');
					setStatus('Session ended. Log in again.');
					return;
				}
				if (!connected) {
					if (hasLiveSignal) {
						setChip('chip-critical', '● Reconnecting · last sample ' + ago(age));
						setStatus('Live updates disconnected. Showing the last successful sample.');
					} else {
						setChip('chip-good', '● Live · connecting…');
						setStatus('Connecting to live updates…');
					}
					updateBanners(age);
					return;
				}
				var stale = updateBanners(age);
				if (stale) {
					setChip('chip-warning', '● Stale · last sample ' + ago(age));
					setStatus('Stale · last sample ' + ago(age));
				} else if (!hasLiveSample) {
					setChip('chip-good', '● Live · connecting…');
					setStatus('Connecting to live updates…');
				} else {
					setChip('chip-good', '● Live · updated ' + ago(age) + notice);
					setStatus('Live · updated ' + ago(age));
				}
			}

			function confirmedAuthFailure(detail) {
				var args = detail && detail.argsRaw;
				return !!args && (args.status === 401 || args.status === '401');
			}

			document.addEventListener('datastar-sse', function(event) {
				var detail = event.detail || {};
				if (detail.elId !== 'sse-root' || authExpired) return;
				if (detail.type === dataEvent) {
					hasLiveSignal = true;
					hasLiveSample = true;
					updateSampleMetadata();
					connected = true;
					if (bannerDc) bannerDc.classList.add('hidden');
					updateChip();
					return;
				}
				if (detail.type === 'started') {
					hasLiveSignal = true;
					hasLiveSample = false;
					connected = true;
					if (bannerDc) bannerDc.classList.add('hidden');
					setChip('chip-good', '● Live · connecting…');
					setStatus('Connecting to live updates…');
					return;
				}
				if (detail.type === 'error' && confirmedAuthFailure(detail)) {
					hasLiveSignal = true;
					authExpired = true;
					connected = false;
					if (sseRoot) sseRoot.removeAttribute('data-on-load');
					if (metricsStream) metricsStream.classList.add('hidden');
					if (bannerDc) bannerDc.classList.add('hidden');
					if (bannerStale) bannerStale.classList.add('hidden');
					if (bannerAuth) bannerAuth.classList.remove('hidden');
					updateChip();
					return;
				}
				if (detail.type === 'finished' || detail.type === 'error') {
					hasLiveSignal = true;
					connected = false;
					if (bannerDc) bannerDc.classList.remove('hidden');
					updateChip();
				}
			});

			if (refreshBtn) refreshBtn.addEventListener('click', function() { location.reload(); });
			setInterval(updateChip, 1000);
			updateBanners(currentSampleAge());
		})();
	</script>
}
