# Test fixture only. Keep this source revision fixed so the MinIO-backed S3
# contract can be reproduced without relying on the Quay registry.
ARG MINIO_SOURCE_REVISION=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a

FROM golang:1.24.8-alpine AS build
ARG MINIO_SOURCE_REVISION

ENV CGO_ENABLED=0
WORKDIR /src

RUN apk add --no-cache ca-certificates git
RUN git init . \
    && git remote add origin https://github.com/minio/minio.git \
    && git fetch --depth=1 origin "${MINIO_SOURCE_REVISION}" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${MINIO_SOURCE_REVISION}" \
    && mkdir -p /out/licenses \
    && go build -trimpath -o /out/minio . \
    && cp LICENSE NOTICE CREDITS /out/licenses/ \
    && printf '%s\n%s\n' 'https://github.com/minio/minio' "${MINIO_SOURCE_REVISION}" > /out/licenses/SOURCE \
    && rm -rf /src /go/pkg/mod /root/.cache/go-build

FROM alpine:3.22
ARG MINIO_SOURCE_REVISION

LABEL org.opencontainers.image.title="MinIO test server" \
      org.opencontainers.image.description="Test-only MinIO server built from pinned upstream source" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.revision="${MINIO_SOURCE_REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

RUN apk add --no-cache ca-certificates
COPY --from=build /out/minio /usr/bin/minio
COPY --from=build /out/licenses/ /licenses/

EXPOSE 9000
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data"]
