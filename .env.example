# Configuration for the local docker-compose.yml stack.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored and must stay that way: it holds the master key that
# decrypts every stored auth key. A copy of this file with real values in it is
# not an example, and 0644 is the default umask on most machines.

# Password for the local Postgres. 5432 is not published anywhere, so an
# obviously-local literal is the honest value — a random-looking one is worse,
# because a reader cannot tell it from live material.
#
# Keep it to [A-Za-z0-9_-]: it is interpolated into a URL, and a password like
# p@ss makes the DSN parse "ss@postgres" as the host.
POSTGRES_PASSWORD=localdev

# AES-256-GCM master key over every auth key at rest. 64 hex chars.
#
# Leave it empty for local work: docker-compose.yml points the server at
# /var/lib/telegramd/enc_key.hex on the tgkey volume, and it generates a key
# there on first boot and reuses it on every restart. The log says so, loudly,
# because a generated key is a dev key.
#
# Set it — `openssl rand -hex 32` — for anything that is not a laptop, where the
# key belongs in whatever holds your other secrets rather than in a container
# volume. A value here wins and no file is written.
#
# No default is committed here on purpose: a working one gets copied somewhere
# that is not local, the server starts fine, and every auth key ends up sealed
# under a key that is public in git.
TG_AUTHKEY_ENC_KEY=

# Where uploaded file bodies are written. The compose stack does not set this:
# the image already points it at /var/lib/telegramd-blobs, which is a named
# volume, and that is the only reason a file uploaded today is still there after
# `docker compose down`. Pointed anywhere else it lands in the container's
# writable layer and dies with the container, silently — the server starts and
# uploads succeed either way.
#
# Whatever it is set to must stay outside anything a future HTTP surface serves
# statically: the bytes here are attacker-supplied and unvalidated.
#
# Left commented for a reason: docker-compose.yml never interpolates it, so
# uncommenting the line below changes nothing. Change the image default or add
# the variable to the telegramd service instead.
# TG_BLOB_DIR=/var/lib/telegramd-blobs

# The server has no SMS or push transport: the login code is written to the log
# and read back from `docker compose logs telegramd`. That is the only way to
# sign in to this stack, and it means every code is in cleartext in the log.
# Local stack, fake numbers only — never set this on anything reachable.
TG_LOG_LOGIN_CODES=true
